{
  "expo": {
    "name": "Sangyin",
    "slug": "sangyin",
    "scheme": "sangyin",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ECEBE0"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sangyin.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.sangyin.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ECEBE0"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/sangyin"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5d861a96-a691-461d-aae9-c25844dea0c0"
      }
    },
    "owner": "watermap"
  }
}
